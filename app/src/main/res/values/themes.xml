<!--themes/themes.xml-->

<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.PBD3FinalCapstone" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->

        <item name="android:statusBarColor">#D3D3D3</item>
        <item name="colorPrimary">#FFFFFF</item>
        <item name="colorPrimaryVariant">#FFFFFF</item>
        <item name="colorSecondary">#FFFFFF</item>
        <item name="colorSecondaryVariant">#FFFFFF</item>
        <item name="colorAccent">#FFFFFF</item>
        <item name="android:colorControlActivated">#FFFFFF</item>
        <item name="android:colorControlHighlight">#FFFFFF</item>
        <item name="android:colorPrimary">#FFFFFF</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#FFFFFF</item>
        <item name="android:editTextColor">#FFFFFF</item>
        <item name="android:textColorHint">#9E9E9E</item>
    </style>

    <style name="Theme.PBD3FinalCapstone" parent="Base.Theme.PBD3FinalCapstone" />

    <style name="TimePickerTheme" parent="Theme.AppCompat.Dialog">
        <item name="android:background">#2A2A2A</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="colorAccent">#EC5454</item>
        <item name="android:colorControlActivated">#EC5454</item>
        <item name="android:numbersTextColor">#FFFFFF</item>
        <item name="android:numbersSelectorColor">#EC5454</item>
    </style>

    <style name="CustomTimePickerTheme" parent="ThemeOverlay.MaterialComponents.TimePicker">
        <item name="buttonBarPositiveButtonStyle">@style/CustomTimePickerButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/CustomTimePickerButton</item>
    </style>

    <style name="CustomTimePickerButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@android:color/black</item>
    </style>

    <!-- Use ThemeOverlay so the context layout inflater actually applies it -->
    <style name="CustomPopupMenuTheme" parent="ThemeOverlay.Material3.Dark">
        <item name="android:colorBackground">#2A2A2A</item>
        <item name="colorSurface">#2A2A2A</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

</resources>